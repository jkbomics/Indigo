manifest {
    name            = 'indigo-nf'
    description     = 'In silico screening workflow for microbial indigo (E. coli host)'
    version         = '0.1.0'
    nextflowVersion = '>=23.10.0'
}

params {
    candidates = "${projectDir}/assets/candidates_template.csv"   // id,uniprot_acc,role
    references = "${projectDir}/assets/reference_enzymes.csv"     // curated known indigo-forming enzymes
    model      = null                                             // SBML of the host GEM (iML1515)
    biomass_id = 'BIOMASS_Ec_iML1515_core_75p37M'
    outdir     = 'results'
    top_n      = 5
    w_identity = 0.5      // placeholder weights - calibrate once wet-lab data exists
    w_plddt    = 0.5
    doe_runs   = 16
    constructs = "${projectDir}/assets/constructs.csv"   // construct_id,members,mutations,notes
    rbs        = 'AAGGAGATATAAAA'   // operon RBS; default, tune with an RBS calculator
    gg_oh5     = 'AATG'             // Golden Gate overhangs: match your toolkit
    gg_oh3     = 'GCTT'
    gc_min     = 0.40
    gc_max     = 0.65
    seed       = 1
}

process {
    errorStrategy = 'retry'
    maxRetries    = 2
    cpus          = 2
    memory        = '4 GB'
    time          = '2h'
}

profiles {
    standard {
        process.executor = 'local'
    }
    conda {
        conda.enabled = true
    }
    slurm {
        process.executor = 'slurm'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
